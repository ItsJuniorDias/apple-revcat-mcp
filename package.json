{
  "name": "apple-revcat-mcp",
  "version": "0.3.0",
  "description": "MCP server for App Store Connect + RevenueCat, tailored for indie iOS developers.",
  "private": true,
  "type": "module",
  "bin": {
    "apple-revcat-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "app-store-connect",
    "revenuecat",
    "indie-dev",
    "ios",
    "claude"
  ],
  "author": "Alexandre Junior",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jose": "^5.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
